{
  "name": "vivapay",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "start": "vite --open",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview --open",
    "live": "npm run build && concurrently -k -n \"BUILD,LIVE\" -c \"yellow,cyan\" \"vite build --watch\" \"live-server dist --port=5500 --open=/index.html --watch=dist\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "live-server": "^1.2.2",
    "vite": "^6.0.3"
  }
}
